+    /**
+     * Keeps each tile's texture coordinates a tenth of a texel inside the tile. At a screen scale
+     * where a tile edge falls on a pixel centre (16-unit tiles at 38.5 px: a 480-unit view on a
+     * 1155 px screen), which of the two tiles gets that pixel depends on the GPU snapping vertices
+     * to a sub-pixel grid (1/16 px on many GPUs), so the pixel can take its texture coordinate
+     * from just past the tile's edge. Nearest sampling then reads the neighbouring tile in the
+     * tileset image, which draws a one-pixel line across the map. A tenth of a texel covers that
+     * snapping at a pixel or more per texel, and moves nothing on screen by more than a fraction
+     * of a pixel. Tile objects (object layers) carry their own copies of the tiles' regions, so
+     * those are inset too.
+     */
+    private static void insetTileRegions(TiledMap map) {
+        java.util.Set<TextureRegion> done = java.util.Collections.newSetFromMap(new java.util.IdentityHashMap<>());
+        for (TiledMapTileSet tileSet : map.getTileSets()) {
+            for (TiledMapTile tile : tileSet) {
+                if (tile instanceof AnimatedTiledMapTile) continue; // its frames are tiles of the set
+                inset(tile.getTextureRegion(), done);
+            }
+        }
+        insetObjects(map.getLayers(), done);
+    }
+
+    private static void insetObjects(MapLayers layers, java.util.Set<TextureRegion> done) {
+        for (MapLayer layer : layers) {
+            if (layer instanceof MapGroupLayer) insetObjects(((MapGroupLayer) layer).getLayers(), done);
+            for (MapObject object : layer.getObjects()) {
+                if (object instanceof TextureMapObject) inset(((TextureMapObject) object).getTextureRegion(), done);
+            }
+        }
+    }
+
+    private static void inset(TextureRegion region, java.util.Set<TextureRegion> done) {
+        if (region == null || region.getTexture() == null || !done.add(region)) return;
+        float du = 0.1f / region.getTexture().getWidth(), dv = 0.1f / region.getTexture().getHeight();
+        // Keeps flips: shrink toward the region's centre whichever way round u/u2, v/v2 are.
+        float u = region.getU(), u2 = region.getU2(), v = region.getV(), v2 = region.getV2();
+        float su = u <= u2 ? du : -du, sv = v <= v2 ? dv : -dv;
+        region.setRegion(u + su, v + sv, u2 - su, v2 - sv);
