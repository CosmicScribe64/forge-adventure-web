+    // The view: the intended (design) size extended in one dimension to the screen's shape, so a
+    // screen that isn't 16:9 shows more of the map instead of stretching it. Layouts are still
+    // made for the intended size (see ViewLayout).
+    private static float viewWidth, viewHeight;
+    private static int viewVersion;
+    private int layoutVersion;
+
+    public static float getViewWidth() {
+        if (viewWidth == 0) updateView(Gdx.graphics.getWidth(), Gdx.graphics.getHeight());
+        return viewWidth;
+    }
+
+    public static float getViewHeight() {
+        if (viewHeight == 0) updateView(Gdx.graphics.getWidth(), Gdx.graphics.getHeight());
+        return viewHeight;
+    }
+
+    /** Recomputes the view for a screen of this size (Forge.resize). */
+    public static void updateView(int screenWidth, int screenHeight) {
+        float iw = getIntendedWidth(), ih = getIntendedHeight();
+        float w = iw, h = ih;
+        if (screenWidth > 0 && screenHeight > 0) {
+            float aspect = (float) screenWidth / screenHeight;
+            if (aspect > iw / ih) w = ih * aspect;
+            else h = iw / aspect;
+        }
+        if (w != viewWidth || h != viewHeight) {
+            viewWidth = w;
+            viewHeight = h;
+            viewVersion++;
+        }
+    }
+
+    /**
+     * Lays the scene out for this screen if it hasn't been yet: after the view changed shape, or
+     * the screen changed size (viewports must know the size to map touches). Forge.switchScene
+     * and Forge.resize call this.
+     */
+    public void refreshView(int screenWidth, int screenHeight) {
+        if (layoutVersion != viewVersion || laidOutWidth != screenWidth || laidOutHeight != screenHeight) {
+            layoutVersion = viewVersion;
+            laidOutWidth = screenWidth;
+            laidOutHeight = screenHeight;
+            resize(screenWidth, screenHeight);
+        }
+    }
+
+    private int laidOutWidth, laidOutHeight;
