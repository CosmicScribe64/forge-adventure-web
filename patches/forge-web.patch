+package forge.adventure.util;
+
+import com.badlogic.gdx.scenes.scene2d.Actor;
+import com.badlogic.gdx.scenes.scene2d.Group;
+import forge.adventure.scene.Scene;
+
+import java.util.Map;
+import java.util.WeakHashMap;
+
+/**
+ * Fits layouts made for the intended screen (Scene.getIntendedWidth/Height, 480x270 or 270x480)
+ * into the view (Scene.getViewWidth/Height), which is wider or taller on screens that aren't 16:9.
+ * Each element keeps its distance to the edge it is nearer to (elements straddling the middle
+ * stay centred), and elements that touch or overlap are placed as one group. Zero-size container
+ * groups are looked through. Elements spanning (nearly) the whole intended width or height, like
+ * backgrounds and bars, are stretched instead.
+ */
+public final class ViewLayout {
+    private static final Map<Actor, float[]> designBounds = new WeakHashMap<>();
+    private static final Map<Group, float[]> lastExtra = new WeakHashMap<>();
+
+    private ViewLayout() {
+    }
+
+    /** Positions root's children for the current view (their first-seen bounds are the design). */
+    public static void anchor(Group root) {
+        float iw = Scene.getIntendedWidth(), ih = Scene.getIntendedHeight();
+        float dx = Scene.getViewWidth() - iw, dy = Scene.getViewHeight() - ih;
+        java.util.List<Actor> list = new java.util.ArrayList<>();
+        collect(root, list);
+        Actor[] actors = list.toArray(new Actor[0]);
+        int n = actors.length;
+        // The extra room root was last laid out with: elements first seen now were placed for that
+        // layout (for example, bounds copied from an anchored element), so undo it to get their design.
+        float[] last = lastExtra.get(root);
+        float lastDx = last == null ? 0 : last[0], lastDy = last == null ? 0 : last[1];
+        float[][] design = new float[n][];
+        for (int i = 0; i < n; i++) {
+            float[] d = designBounds.get(actors[i]);
+            if (d == null) {
+                Actor a = actors[i];
+                d = new float[] {a.getX(), a.getY(), a.getWidth(), a.getHeight()};
+                if (lastDx != 0 || lastDy != 0) {
+                    if (d[2] >= iw + lastDx - 0.5f && lastDx != 0) d[2] -= lastDx;
+                    if (d[3] >= ih + lastDy - 0.5f && lastDy != 0) d[3] -= lastDy;
+                    if (d[2] < iw * 0.9f) d[0] -= shift(d[0], d[2], iw + lastDx, lastDx);
+                    if (d[3] < ih * 0.9f) d[1] -= shift(d[1], d[3], ih + lastDy, lastDy);
+                }
+                designBounds.put(a, d);
+            }
+            design[i] = d;
+        }
+        lastExtra.put(root, new float[] {dx, dy});
+        // Elements that touch or overlap (a toolbar's buttons, a panel and what is on it) move as
+        // one: anchor each such group by its combined bounds. Stretched elements don't group.
+        int[] group = new int[n];
+        for (int i = 0; i < n; i++) group[i] = i;
+        for (int i = 0; i < n; i++) {
+            if (spans(design[i], iw, ih)) continue;
+            for (int j = i + 1; j < n; j++) {
+                if (!spans(design[j], iw, ih) && touch(design[i], design[j])) union(group, i, j);
+            }
+        }
+        float[][] bounds = new float[n][];
+        for (int i = 0; i < n; i++) {
+            int g = find(group, i);
+            float[] d = design[i], b = bounds[g];
+            if (b == null) {
+                bounds[g] = new float[] {d[0], d[1], d[0] + d[2], d[1] + d[3]};
+            } else {
+                b[0] = Math.min(b[0], d[0]);
+                b[1] = Math.min(b[1], d[1]);
+                b[2] = Math.max(b[2], d[0] + d[2]);
+                b[3] = Math.max(b[3], d[1] + d[3]);
+            }
+        }
+        for (int i = 0; i < n; i++) {
+            float[] d = design[i], b = bounds[find(group, i)];
+            boolean spansX = d[2] >= iw * 0.9f, spansY = d[3] >= ih * 0.9f;
+            float x = spansX ? d[0] : d[0] + shift(b[0], b[2] - b[0], iw, dx);
+            float y = spansY ? d[1] : d[1] + shift(b[1], b[3] - b[1], ih, dy);
+            // Only the position, and the stretched dimension of spanning elements: sizes a scene
+            // sets later (labels, packed tables) stay as they are.
+            Actor a = actors[i];
+            a.setBounds(x, y, spansX ? d[2] + dx : a.getWidth(), spansY ? d[3] + dy : a.getHeight());
+        }
+    }
+
+    /**
+     * The elements to place: root's children, except that zero-size groups at the origin (pure
+     * containers, like GameHUD's map/avatar/menu groups) contribute their children instead.
+     */
+    private static void collect(Group root, java.util.List<Actor> out) {
+        for (Actor a : root.getChildren()) {
+            if (a instanceof Group && !(a instanceof com.badlogic.gdx.scenes.scene2d.ui.WidgetGroup)
+                    && a.getWidth() == 0 && a.getHeight() == 0 && a.getX() == 0 && a.getY() == 0) {
+                collect((Group) a, out);
+            } else {
+                out.add(a);
+            }
+        }
+    }
+
+    private static boolean spans(float[] d, float iw, float ih) {
+        return d[2] >= iw * 0.9f || d[3] >= ih * 0.9f;
+    }
+
+    private static boolean touch(float[] a, float[] b) {
+        final float gap = 3;
+        return a[0] <= b[0] + b[2] + gap && b[0] <= a[0] + a[2] + gap
+                && a[1] <= b[1] + b[3] + gap && b[1] <= a[1] + a[3] + gap;
+    }
+
+    private static int find(int[] group, int i) {
+        while (group[i] != i) {
+            group[i] = group[group[i]];
+            i = group[i];
+        }
+        return i;
+    }
+
+    private static void union(int[] group, int a, int b) {
+        group[find(group, a)] = find(group, b);
+    }
+
+    /**
+     * How far an element at pos with this size moves when the design size grows by extra. An element
+     * that straddles the middle stays centred. Otherwise it moves with the nearer edge, so the parts
+     * of a corner panel move together.
+     */
+    public static float shift(float pos, float size, float design, float extra) {
+        float middle = design / 2;
+        if (pos < middle && pos + size > middle) return extra / 2;
+        return pos + size / 2 < middle ? 0 : extra;
+    }
+}
