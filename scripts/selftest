#!/usr/bin/env bash
# Fast check of the web runtime without Forge: builds forgeweb.selftest.SelfTest, serves it
# with the game data on port 8092, runs it in headless Chromium and prints the results.
# Exit code 0 only if every check passed. Output: web/build/dist/selftest, log out/selftest-js.log
# TEAVM_OBFUSCATED=true compiles SelfTest with minified names (the release build is minified).
# TARGET=wasm builds the WebAssembly GC target instead (web/build/dist/selftest-wasm).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
mkdir -p "$ROOT/web/build" "$ROOT/out"
TARGET="${TARGET:-js}"
DIST=selftest; [ "$TARGET" = wasm ] && DIST=selftest-wasm

if [ "${SKIP_BUILD:-}" != "1" ]; then
  DOCK_CWD=web DOCK_ENV="SELFTEST=true -e REFLECTION_DEBUG=${REFLECTION_DEBUG:-false} -e TEAVM_MEMORY_MB=${TEAVM_MEMORY_MB:-5120} -e TEAVM_OPT=${TEAVM_OPT:-BALANCED} -e TEAVM_OBFUSCATED=${TEAVM_OBFUSCATED:-false} -e REACH_REPORT=${REACH:+/work/out/reach-selftest-$TARGET.txt}" \
    "$ROOT/scripts/dock" 'export GRADLE_OPTS="-Xmx1g -Dorg.gradle.daemon=false"; gradle --console=plain gdx_teavm_web_'$TARGET'_build 2>&1; echo "build peak memory: $(( $(cat /sys/fs/cgroup/memory.peak) / 1048576 )) MB"' \
    > "$ROOT/web/build/selftest-$TARGET-build.log" || true
  if ! grep -q "BUILD SUCCESSFUL" "$ROOT/web/build/selftest-$TARGET-build.log"; then
    grep -E " error: |was not found|has no implementation|FAILED" "$ROOT/web/build/selftest-$TARGET-build.log" | head -20
    tail -5 "$ROOT/web/build/selftest-$TARGET-build.log"
    exit 1
  fi
fi

SITE="$(find "$ROOT/web/build/dist/$DIST" -name index.html -exec dirname {} \; | head -1)"
docker rm -f forge-selftest-serve >/dev/null 2>&1 || true
docker run -d --rm --name forge-selftest-serve -p 8092:8080 \
  -v "$SITE":/site \
  -v "$ROOT/forge/forge-gui/res":/site/forge/res:ro \
  -v "$ROOT/web/webdata":/site/forge-data:ro \
  -w /site forge-adventure-web-build python3 -m http.server 8080 >/dev/null
trap 'docker rm -f forge-selftest-serve >/dev/null 2>&1 || true' EXIT

"$ROOT/scripts/webtest" --url http://host.docker.internal:8092/index.html --log out/selftest-$TARGET.log \
  --steps "until 'SELFTEST DONE' ${SELFTEST_TIMEOUT:-300}" >/dev/null || true
grep -E "SELFTEST|BENCH|^\[[^]]*\] \[[a-z]*\]   " "$ROOT/out/selftest-$TARGET.log" 
grep -q "SELFTEST DONE" "$ROOT/out/selftest-$TARGET.log" || { echo "SELFTEST did not finish; see out/selftest-$TARGET.log"; exit 1; }
! grep -q "SELFTEST FAIL" "$ROOT/out/selftest-$TARGET.log"
