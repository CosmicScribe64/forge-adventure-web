# Shared by scripts/e2e-boot, e2e-newgame and e2e-cycle (sourced, not run). Sets the device, the URL
# and the server. Expects ROOT and PORT to be set by the caller.
#
# Device: the first argument or DEVICE, one of
#   desktop  headless Chromium, 1280x720 at scale 1 (the default),
#   phone    Chromium emulating a phone: 390x844, scale 3, mobile, touch (taps), mobile user agent,
#   iphone   WebKit with Playwright's "iPhone 13" descriptor (WebKit is what every iPhone browser
#            runs, Chrome and Safari alike). IPHONE_DEVICE picks another descriptor.
# Where to load the game: by default scripts/serve-web serves the build on PORT. URL=<site root>
# loads a site that is already running instead (for example the release rehearsal on a subpath,
# URL=http://host.docker.internal:8097/forge-adventure-web/, or the live site,
# URL=https://cosmicscribe64.github.io/forge-adventure-web/); no server is started then.
# E2E_CACHE_BUST=<text> adds a query parameter to the page URL, so a CDN that caches by URL serves the
# current index.html (the post-deploy check passes the commit). SERVER=0 uses a server that is already running on PORT. Log and screenshot names get the device as
# a suffix unless it is desktop. VIEW_W x VIEW_H is the device's viewport and SMALL_W x SMALL_H a smaller one for
# the resize checks (a phone's browser bars appearing: 844 to 700 high). The webtest step display-check asserts that
# the canvas fills the visible viewport at the capped pixel ratio, that the game agrees and that the page can't scroll.
# E2E_QUERY=<text> adds query parameters to the page URL (pixelratio=3 forces a backing store ratio, for measuring;
# then DISPLAY_CAP=3 tells display-check what to expect; the default cap is 2, the page's FORGE_MAX_PIXEL_RATIO).
DISPLAY_CAP="${DISPLAY_CAP:-2}"
# AUDIO_CHECK: on a touch device a fresh profile must not play anything after the taps (audio is off until the player
# raises the volumes in Settings, forge.web.WebLauncher); the desktop plays music from the title screen on (headless Chromium allows autoplay), which AUDIO_CHECK asserts once; AUDIO_CHECK_END is for the overworld.
DEVICE="${1:-${DEVICE:-desktop}}"
case "$DEVICE" in
  desktop) DEVICE_ARGS=(); SUFFIX=""; AUDIO_CHECK="audio-check playing;"; AUDIO_CHECK_END=""; VIEW_W=1280; VIEW_H=720; SMALL_W=1000; SMALL_H=600 ;;
  phone)   DEVICE_ARGS=(--phone); SUFFIX="-phone"; AUDIO_CHECK="audio-check none;"; AUDIO_CHECK_END="audio-check none;"; VIEW_W=390; VIEW_H=844; SMALL_W=390; SMALL_H=700 ;;
  iphone)  DEVICE_ARGS=(--browser webkit --device "${IPHONE_DEVICE:-iPhone 13}"); SUFFIX="-iphone"; AUDIO_CHECK="audio-check none;"; AUDIO_CHECK_END="audio-check none;"; VIEW_W=390; VIEW_H=664; SMALL_W=390; SMALL_H=560 ;;
  *) echo "unknown device '$DEVICE' (desktop, phone or iphone)" >&2; exit 2 ;;
esac
if [ -n "${URL:-}" ]; then
  GAME_URL="${URL%/}/index.html?test=1&seed=1${E2E_CACHE_BUST:+&cb=$E2E_CACHE_BUST}${E2E_QUERY:+&$E2E_QUERY}"
  SERVER=0
else
  GAME_URL="http://host.docker.internal:$PORT/index.html?test=1&seed=1${E2E_QUERY:+&$E2E_QUERY}"
fi

e2e_start_server() {
  if [ "${SERVER:-1}" != 0 ]; then
    docker rm -f forge-web-serve >/dev/null 2>&1 || true
    PORT="$PORT" "$ROOT/scripts/serve-web" >/dev/null 2>&1 &
    trap 'docker rm -f forge-web-serve >/dev/null 2>&1 || true' EXIT
    for _ in $(seq 1 60); do
      curl -fsS -o /dev/null "http://localhost:$PORT/index.html" 2>/dev/null && break
      sleep 1
    done
  fi
}
