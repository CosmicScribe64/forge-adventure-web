#!/usr/bin/env bash
# New-game scenario: serves the built game (scripts/serve-web), loads it with the world seed 1 in
# headless Chromium, starts a new game, waits for the overworld, and checks that
#   - the console has no unexpected errors (known harmless ones: web/tools/webtest.py),
#   - renderer RSS, JS heap, live WebGL texture memory and the wasm pixmap heap stay under the limits
#     below, measured at the title screen and at the overworld (and RSS does not rise by more than a
#     set amount between the two),
#   - no file of 1 MB or more was requested twice (same URL and Range).
# Needs scripts/build-web and scripts/build-webdata first. Exit code 0 only if everything held.
# Log: out/e2e-newgame.log, screenshots: out/e2e-newgame-menu.png and out/e2e-newgame-world.png.
# PORT sets the server port (default 8090); SERVER=0 uses a server that is already running there.
# EXTRA adds webtest arguments. The device (desktop, phone, iphone), URL and SERVER are explained in
# scripts/e2e-common; usage: scripts/e2e-newgame [desktop|phone|iphone]. The limits below are
# for desktop and phone (each has its own block); WebKit can't report process memory the way Chromium
# does, so the iphone run asserts function only and prints what it can measure.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PORT="${PORT:-8090}"
cd "$ROOT"
mkdir -p out

# Desktop limits in MB, all in this one place. Set on 2026-10-05 from the minified build (the release build,
# TEAVM_OBFUSCATED=true) on desktop 1280x720, headless Chromium with software GL (SwiftShader) in the
# Playwright container, seed 1, default 700x700 world, 4 cores (so 3 WFC workers), after the commits
# "Terminate the WFC worker pool", "Drop the JS copy of big pixmaps", "Size WorldBackground's chunk
# arrays by chunk count" and "Dispose the previous world's minimap image and tile map". Numbers are in
# wiki/concepts/memory-budget.md. Runs vary by a few MB (RSS by up to about 10 MB).
#
# What each limit has to catch, and how much room it leaves:
#   JS heap, textures, wasm pixmap heap: the same on any machine (the JS and the GL calls are the same),
#     so they are tight (5 to 8 percent above the measured value). A new game that keeps its old world
#     (the 31 MB pixmap and 11.7 MB of tiles) fails the pixmap and texture limits only in e2e-cycle,
#     which compares games; here one game fits, so these catch a bigger world image, a tileset kept
#     twice, or a card database that grew.
#   Renderer RSS depends on the machine (GitHub's runners may differ from this sandbox), so the absolute
#     limits are loose (about 110 MB above the measured value), and the real check is the difference
#     between the overworld and the menu, which does not depend on the machine's base footprint:
#     measured 110 MB, limit 140 MB. The WFC workers that were never terminated (3 x 44 MB, 133 MB in
#     all, wiki/concepts/memory-budget.md) would have made it 243 MB and the overworld RSS 813 MB: both
#     fail. The worker count is min(8, cores - 1); with one worker (2 cores) the difference would be
#     154 MB, which still fails. The per-game leaks (a kept 31 MB minimap image, 11.7 MB of tiles) show
#     only when games are compared, which scripts/e2e-cycle does.
# Raise a limit only after finding out why the number grew, and record the new measurement there.
# measured at the title screen:  rss 563-580 MB, heap 246.5 MB, textures 75.4 MB, pixmap heap 7 MB
# measured at the overworld:     rss 673-690 MB, heap 267.4 MB, textures 124.0 MB, pixmap heap 40 MB
MENU_RSS_MAX=680
MENU_HEAP_MAX=265
MENU_TEX_MAX=80
MENU_PIX_MAX=10
WORLD_RSS_MAX=790
WORLD_HEAP_MAX=288
WORLD_TEX_MAX=130
WORLD_PIX_MAX=45
WORLD_RSS_RISE_MAX=140

# Phone limits: Chromium emulating a phone (390x844, scale 3, mobile, touch, mobile user agent), same build,
# seed and machine as above. Measured 2026-10-05 on the minified build: at the title screen RSS 576 MB, heap
# 245.8 MB, textures 73.5 MB, pixmap heap 7 MB; at the overworld RSS 687, heap 267.6, textures 122.2, pixmap
# heap 40, RSS rise 111. These equal the desktop numbers within a few MB. Since 2026-10-06 the canvas is drawn at a pixel
# ratio of 2 (780x1688, wiki/concepts/display-and-viewport.md), which moved the renderer numbers by nothing measurable (RSS 532 at
# the title and 627 at the overworld, rise 95 to 97) and the GPU process by about 47 MB at the title; the limits are unchanged.
# The margins are the same as for desktop. A real iPhone has a lower memory limit than this container, which this
# test can't show (see the iphone run, wiki/concepts/memory-budget.md).
PHONE_MENU_RSS_MAX=680
PHONE_MENU_HEAP_MAX=265
PHONE_MENU_TEX_MAX=80
PHONE_MENU_PIX_MAX=10
PHONE_WORLD_RSS_MAX=790
PHONE_WORLD_HEAP_MAX=288
PHONE_WORLD_TEX_MAX=130
PHONE_WORLD_PIX_MAX=45
PHONE_WORLD_RSS_RISE_MAX=140

. "$ROOT/scripts/e2e-common"
case "$DEVICE" in
  phone)
    MENU_RSS_MAX=$PHONE_MENU_RSS_MAX; MENU_HEAP_MAX=$PHONE_MENU_HEAP_MAX; MENU_TEX_MAX=$PHONE_MENU_TEX_MAX; MENU_PIX_MAX=$PHONE_MENU_PIX_MAX
    WORLD_RSS_MAX=$PHONE_WORLD_RSS_MAX; WORLD_HEAP_MAX=$PHONE_WORLD_HEAP_MAX; WORLD_TEX_MAX=$PHONE_WORLD_TEX_MAX; WORLD_PIX_MAX=$PHONE_WORLD_PIX_MAX
    WORLD_RSS_RISE_MAX=$PHONE_WORLD_RSS_RISE_MAX ;;
esac
if [ "$DEVICE" = iphone ]; then
  MENU_ASSERTS=""; WORLD_ASSERTS=""   # recorded, not asserted (see the header)
else
  MENU_ASSERTS="assert-max menu.rss $MENU_RSS_MAX; assert-max menu.heap $MENU_HEAP_MAX; assert-max menu.tex $MENU_TEX_MAX; assert-max menu.pix $MENU_PIX_MAX;"
  WORLD_ASSERTS="assert-max world.rss $WORLD_RSS_MAX; assert-max world.heap $WORLD_HEAP_MAX; assert-max world.tex $WORLD_TEX_MAX; assert-max world.pix $WORLD_PIX_MAX; assert-growth menu.rss world.rss $WORLD_RSS_RISE_MAX;"
fi
e2e_start_server

# The buttons are pressed with real input (the webtest step `tap`: a touch tap on a phone, a mouse click on
# desktop). NEWGAME_INPUT=api calls the stage directly instead, for a build older than the harness's `where`
# command (the live 0.1.1 site).
CLICK=tap
[ "${NEWGAME_INPUT:-tap}" = api ] && CLICK="api click"

# Waiting is on game state and console lines, not fixed delays, except the 10 s after world
# generation: the WFC workers are terminated 5 s after the last reply and the minimap's JS copy is
# dropped 5 s after its last use, and the numbers are taken after both.
# shellcheck disable=SC2086
"$ROOT/scripts/webtest" --url "$GAME_URL" "${DEVICE_ARGS[@]}" \
  --strict --heartbeat 30 --max-time "${E2E_TIMEOUT:-600}" ${EXTRA:-} \
  --init-script web/tools/glhook.js --log "out/e2e-newgame$SUFFIX.log" \
  --steps "until-state state.scene=='StartScene' ${E2E_BOOT_TIMEOUT:-240}; wait 4; shot out/e2e-newgame-menu$SUFFIX.png; measure menu; $MENU_ASSERTS display-check $DISPLAY_CAP; resize $SMALL_W $SMALL_H; wait 2; display-check $DISPLAY_CAP; resize $VIEW_W $VIEW_H; wait 2; display-check $DISPLAY_CAP; $CLICK New Game; until 'ui/new_game' 60; wait 3; $CLICK start; until 'Generating world took' 400; until-state ['TileMapScene','GameScene'].includes(state.scene) 120; wait 10; shot out/e2e-newgame-world$SUFFIX.png; display-check $DISPLAY_CAP; measure world; $WORLD_ASSERTS no-repeat-downloads 1; no-errors" \
  | grep -vE '^\[ *[0-9.]+s\] \[hb\]'
